# Copy to bot/.env (gitignored) and fill in. `doctl serverless deploy bot` pushes these into the function –
# values set in the DO console are overwritten on every deploy, so this file is the one source.
# The two webhook secrets are any random strings: openssl rand -hex 32
# GITHUB_TOKEN: fine-grained PAT for OlegPasko/cherkasy-drive with Issues: Read and write
# DARKBLOOM_API_KEY (Gemma on Oleg's own nodes, free) then DEEPSEEK_API_KEY (fallback) read donation proofs.
#   Without both, every proof goes to Oleg for a manual check. doctl rejects empty values, so "none" = unset.
# OPENAI_API_KEY writes the daily news (gpt-6-luna; OPENAI_MODEL overrides), with Gemma on Darkbloom as the fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=OlegPasko/cherkasy-drive
TYPESAFE_API_KEY=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=everlabs-file-uploads
SPACES_REGION=fra1
ADMIN_CHAT_ID=237142980
DARKBLOOM_API_KEY=none
DEEPSEEK_API_KEY=none
OPENAI_API_KEY=none
